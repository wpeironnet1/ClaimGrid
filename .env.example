# Public canonical origin used for metadata, robots.txt, and sitemap.xml.
# Must be an HTTPS origin with no path, query string, or credentials.
NEXT_PUBLIC_SITE_URL=

# Server-only Stripe configuration. Never prefix these with NEXT_PUBLIC_.
STRIPE_SECRET_KEY=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_ANNUAL_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
# Durable, idempotent account-entitlement receiver. Required before checkout opens.
CLAIMGRID_ENTITLEMENT_STORE_URL=
CLAIMGRID_ENTITLEMENT_STORE_TOKEN=
